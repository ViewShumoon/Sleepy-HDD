<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>SleepyHDD.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 票 #12：发布产物的 exe 图标，取自托盘常态图标（Assets\tray-normal.png，32x32 单帧 ICO）。 -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <!-- 票 #12：模板遗留的 PublishProfile 指向不存在的 win-$(Platform).pubxml（NETSDK1198 警告），
         且 *.pubxml 在 .gitignore 内无法入库；发布配置统一收敛在本 csproj 与发布命令中。 -->
    <UseWinUI>true</UseWinUI>
    <ImplicitUsings>enable</ImplicitUsings>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <!-- issue #8：免安装 unpackaged 部署（ADR-0004），Windows App Runtime 由启动路径自行引导。 -->
    <WindowsPackageType>None</WindowsPackageType>
    <!-- 禁用自动注入的 bootstrap/deployment 初始化：失败时自动初始化器会直接退出进程，无法满足"引导安装后继续启动"。 -->
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
    <WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
    <!-- 禁用 XAML 生成的入口点，改用自定义 Program.Main（先检测运行时，再启动 WinUI）。
         注意：需直接定义 C# 符号，WindowsAppSDK 2.6.5 不会把同名 MSBuild 属性映射为编译常量。 -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
    <!-- 票 #7：托盘图标常态/睡眠变体，运行时从输出目录加载。
         票 #12：显式声明发布复制——Content 默认不进 publish 目录，缺失会导致发布产物启动时托盘构造抛异常。 -->
    <Content Include="Assets\tray-normal.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\tray-sleeping.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- 票 #7：WinUI 3 无内置托盘，按 DESIGN.md 第 3 节采用 H.NotifyIcon（2.4.1 仅含 net10.0 目标，取支持 net8.0 的 2.3.2）。 -->
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.3.2" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SleepyHDD.Core\SleepyHDD.Core.csproj" />
    <ProjectReference Include="..\SleepyHDD.Native\SleepyHDD.Native.csproj" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <!-- 票 #12：关闭模板默认的裁剪发布——WinUI 3 / WindowsAppSDK 不支持 trimming，
         且 Store 的 System.Text.Json 反射序列化在裁剪下产生 IL2026、settings/state 持久化有运行时断裂风险。 -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
</Project>