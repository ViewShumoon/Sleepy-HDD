<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SleepyHDD.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SleepyHDD.App"
    xmlns:converters="using:SleepyHDD.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Sleepy HDD">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Padding="24,20,24,24">
        <Grid.Resources>
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶栏：标题 + 全局按钮（"全部休眠/全部离线"文案跟随默认动作 + "全部唤醒"，票 #6，DESIGN.md 4.1） -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <TextBlock
                FontSize="24"
                FontWeight="SemiBold"
                Text="{Binding HeaderText}" />
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8"
                Visibility="{Binding IsDiskViewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Button
                    Content="{Binding SleepAllLabel}"
                    Command="{Binding DefaultActionAllCommand}" />
                <Button
                    Content="全部唤醒"
                    Command="{Binding WakeAllCommand}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <!-- 磁盘视图：卡片列表 / 空态 -->
            <Grid Visibility="{Binding IsDiskViewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">

                <!-- 空态：未发现受管机械盘 -->
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <FontIcon
                        Glyph="&#xE88E;"
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        FontSize="48"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="未发现受管的机械硬盘" />
                </StackPanel>

                <!-- 磁盘卡片列表 -->
                <ScrollViewer Visibility="{Binding HasDisks, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl ItemsSource="{Binding Disks}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="12" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Padding="16"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <StackPanel Spacing="6">
                                        <Grid>
                                            <TextBlock
                                                HorizontalAlignment="Left"
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                Text="{Binding Model}"
                                                TextTrimming="CharacterEllipsis" />
                                            <!-- 状态徽章：在线（绿）/ 休眠（黄）/ 离线（灰）；受限盘另显红字徽章 -->
                                            <Border
                                                HorizontalAlignment="Right"
                                                Padding="8,2"
                                                Background="{Binding BadgeBrush}"
                                                CornerRadius="4"
                                                Visibility="{Binding IsNotRestricted, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="White"
                                                    Text="{Binding StateText}" />
                                            </Border>
                                            <Border
                                                HorizontalAlignment="Right"
                                                Padding="8,2"
                                                Background="#C62828"
                                                CornerRadius="4"
                                                Visibility="{Binding IsRestricted, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <ToolTipService.ToolTip>
                                                    <ToolTip Content="{Binding RestrictedReasonsText}" />
                                                </ToolTipService.ToolTip>
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="White"
                                                    Text="{Binding StatusText}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </Border>
                                        </Grid>
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding CapacityText}" />
                                        <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Volumes}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3">
                                                        <TextBlock
                                                            HorizontalAlignment="Left"
                                                            Text="{Binding Header}" />
                                                        <TextBlock
                                                            HorizontalAlignment="Right"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="{Binding UsageText}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <!-- 默认动作/唤醒单按钮与失败反馈（占用进程报告）；受限盘无动作按钮 -->
                                        <Grid
                                            Margin="0,10,0,0"
                                            Visibility="{Binding IsNotRestricted, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                MaxWidth="360"
                                                Foreground="#C62828"
                                                Text="{Binding StatusMessage}"
                                                TextWrapping="Wrap"
                                                Visibility="{Binding HasStatusMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <Button
                                                HorizontalAlignment="Right"
                                                Content="{Binding ActionText}"
                                                Command="{Binding ToggleCommand}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- 设置页：本票仅默认动作（DESIGN.md 4.2）；定时策略/开机自启/关于属其他票 -->
            <StackPanel
                MaxWidth="520"
                HorizontalAlignment="Left"
                Spacing="8"
                Visibility="{Binding IsSettingsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="默认动作" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="对在线磁盘执行的动作；顶栏全局按钮与磁盘卡片按钮均随此设置。"
                    TextWrapping="Wrap" />
                <RadioButtons SelectedIndex="{Binding Settings.DefaultActionIndex, Mode=TwoWay}">
                    <x:String>休眠</x:String>
                    <x:String>离线</x:String>
                </RadioButtons>
                <Button
                    Margin="0,16,0,0"
                    HorizontalAlignment="Left"
                    Content="返回"
                    Command="{Binding CloseSettingsCommand}" />
            </StackPanel>
        </Grid>

        <!-- 底栏：左下角设置入口（DESIGN.md 4.1） -->
        <Button
            Grid.Row="2"
            Margin="0,16,0,0"
            HorizontalAlignment="Left"
            Command="{Binding OpenSettingsCommand}"
            Visibility="{Binding IsDiskViewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon
                    Glyph="&#xE713;"
                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                    FontSize="16" />
                <TextBlock Text="设置" />
            </StackPanel>
        </Button>
    </Grid>
</Window>
