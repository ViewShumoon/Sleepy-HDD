<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SleepyHDD.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SleepyHDD.App"
    xmlns:converters="using:SleepyHDD.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Sleepy HDD">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Padding="24,20,24,24">
        <Grid.Resources>
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,16"
            FontSize="24"
            FontWeight="SemiBold"
            Text="受管磁盘" />

        <!-- 空态：未发现受管机械盘 -->
        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
            <FontIcon
                Glyph="&#xE88E;"
                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                FontSize="48"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="未发现受管的机械硬盘" />
        </StackPanel>

        <!-- 磁盘卡片列表 -->
        <ScrollViewer
            Grid.Row="1"
            Visibility="{Binding HasDisks, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ItemsControl ItemsSource="{Binding Disks}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="12" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Padding="16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel Spacing="6">
                                <Grid>
                                    <TextBlock
                                        HorizontalAlignment="Left"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Text="{Binding Model}"
                                        TextTrimming="CharacterEllipsis" />
                                    <!-- 状态徽章：在线（绿）/ 休眠（黄）/ 离线（灰）；受限盘另显红字徽章 -->
                                    <Border
                                        HorizontalAlignment="Right"
                                        Padding="8,2"
                                        Background="{Binding BadgeBrush}"
                                        CornerRadius="4"
                                        Visibility="{Binding IsNotRestricted, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="White"
                                            Text="{Binding StateText}" />
                                    </Border>
                                    <Border
                                        HorizontalAlignment="Right"
                                        Padding="8,2"
                                        Background="#C62828"
                                        CornerRadius="4"
                                        Visibility="{Binding IsRestricted, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <ToolTipService.ToolTip>
                                            <ToolTip Content="{Binding RestrictedReasonsText}" />
                                        </ToolTipService.ToolTip>
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="White"
                                            Text="{Binding StatusText}"
                                            TextTrimming="CharacterEllipsis" />
                                    </Border>
                                </Grid>
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{Binding CapacityText}" />
                                <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Volumes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <TextBlock
                                                    HorizontalAlignment="Left"
                                                    Text="{Binding Header}" />
                                                <TextBlock
                                                    HorizontalAlignment="Right"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding UsageText}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- 休眠/唤醒动作与失败反馈（占用进程报告）；受限盘无动作按钮 -->
                                <Grid
                                    Margin="0,10,0,0"
                                    Visibility="{Binding IsNotRestricted, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        MaxWidth="360"
                                        Foreground="#C62828"
                                        Text="{Binding StatusMessage}"
                                        TextWrapping="Wrap"
                                        Visibility="{Binding HasStatusMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <Button
                                        HorizontalAlignment="Right"
                                        Content="{Binding ActionText}"
                                        Command="{Binding ToggleCommand}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
