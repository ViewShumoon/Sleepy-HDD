<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SleepyHDD.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SleepyHDD.App"
    xmlns:converters="using:SleepyHDD.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Sleepy HDD">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Padding="24,20,24,24">
        <Grid.Resources>
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <!-- 新增定时策略对话框（票 #10，DESIGN.md 4.2）：磁盘、时间、星期、目标状态；由 code-behind 打开 -->
            <ContentDialog
                x:Key="AddScheduleDialog"
                Title="新增定时策略"
                PrimaryButtonText="保存"
                CloseButtonText="取消"
                DefaultButton="Primary"
                IsPrimaryButtonEnabled="{Binding CanAddSchedule}">
                <StackPanel MinWidth="340" Spacing="12">
                    <ComboBox
                        HorizontalAlignment="Stretch"
                        Header="磁盘"
                        ItemsSource="{Binding DialogDisks}"
                        SelectedItem="{Binding DialogDisk, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TimePicker
                        HorizontalAlignment="Stretch"
                        Header="触发时间"
                        Time="{Binding DialogTime, Mode=TwoWay}" />
                    <TextBlock Text="重复星期" />
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <CheckBox Content="周一" IsChecked="{Binding IsMonday, Mode=TwoWay}" />
                        <CheckBox Content="周二" IsChecked="{Binding IsTuesday, Mode=TwoWay}" />
                        <CheckBox Content="周三" IsChecked="{Binding IsWednesday, Mode=TwoWay}" />
                        <CheckBox Content="周四" IsChecked="{Binding IsThursday, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <CheckBox Content="周五" IsChecked="{Binding IsFriday, Mode=TwoWay}" />
                        <CheckBox Content="周六" IsChecked="{Binding IsSaturday, Mode=TwoWay}" />
                        <CheckBox Content="周日" IsChecked="{Binding IsSunday, Mode=TwoWay}" />
                    </StackPanel>
                    <RadioButtons
                        Header="目标状态"
                        SelectedIndex="{Binding DialogTargetIndex, Mode=TwoWay}">
                        <x:String>休眠</x:String>
                        <x:String>离线</x:String>
                    </RadioButtons>
                </StackPanel>
            </ContentDialog>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶栏：标题 + 全局按钮（"全部休眠/全部离线"文案跟随默认动作 + "全部唤醒"，票 #6，DESIGN.md 4.1） -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <TextBlock
                FontSize="24"
                FontWeight="SemiBold"
                Text="{Binding HeaderText}" />
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8"
                Visibility="{Binding IsDiskViewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Button
                    Content="{Binding SleepAllLabel}"
                    Command="{Binding DefaultActionAllCommand}" />
                <Button
                    Content="全部唤醒"
                    Command="{Binding WakeAllCommand}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <!-- 磁盘视图：卡片列表 / 空态 -->
            <Grid Visibility="{Binding IsDiskViewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">

                <!-- 空态：未发现受管机械盘 -->
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <FontIcon
                        Glyph="&#xE88E;"
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        FontSize="48"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="未发现受管的机械硬盘" />
                </StackPanel>

                <!-- 磁盘卡片列表 -->
                <ScrollViewer Visibility="{Binding HasDisks, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl ItemsSource="{Binding Disks}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="12" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Padding="16"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <StackPanel Spacing="6">
                                        <Grid>
                                            <TextBlock
                                                HorizontalAlignment="Left"
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                Text="{Binding Model}"
                                                TextTrimming="CharacterEllipsis" />
                                            <!-- 状态徽章：在线（绿）/ 休眠（黄）/ 离线（灰）；受限盘另显红字徽章 -->
                                            <Border
                                                HorizontalAlignment="Right"
                                                Padding="8,2"
                                                Background="{Binding BadgeBrush}"
                                                CornerRadius="4"
                                                Visibility="{Binding IsNotRestricted, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="White"
                                                    Text="{Binding StateText}" />
                                            </Border>
                                            <Border
                                                HorizontalAlignment="Right"
                                                Padding="8,2"
                                                Background="#C62828"
                                                CornerRadius="4"
                                                Visibility="{Binding IsRestricted, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <ToolTipService.ToolTip>
                                                    <ToolTip Content="{Binding RestrictedReasonsText}" />
                                                </ToolTipService.ToolTip>
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="White"
                                                    Text="{Binding StatusText}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </Border>
                                        </Grid>
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding CapacityText}" />
                                        <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Volumes}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3">
                                                        <TextBlock
                                                            HorizontalAlignment="Left"
                                                            Text="{Binding Header}" />
                                                        <TextBlock
                                                            HorizontalAlignment="Right"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="{Binding UsageText}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <!-- 默认动作/唤醒单按钮与失败反馈（占用进程报告）；受限盘无动作按钮 -->
                                        <Grid
                                            Margin="0,10,0,0"
                                            Visibility="{Binding IsNotRestricted, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                MaxWidth="360"
                                                Foreground="#C62828"
                                                Text="{Binding StatusMessage}"
                                                TextWrapping="Wrap"
                                                Visibility="{Binding HasStatusMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <Button
                                                HorizontalAlignment="Right"
                                                Content="{Binding ActionText}"
                                                Command="{Binding ToggleCommand}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- 设置页：本票仅默认动作（DESIGN.md 4.2）；定时策略/开机自启/关于属其他票 -->
            <StackPanel
                MaxWidth="520"
                HorizontalAlignment="Left"
                Spacing="8"
                Visibility="{Binding IsSettingsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="默认动作" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="对在线磁盘执行的动作；顶栏全局按钮与磁盘卡片按钮均随此设置。"
                    TextWrapping="Wrap" />
                <RadioButtons SelectedIndex="{Binding Settings.DefaultActionIndex, Mode=TwoWay}">
                    <x:String>休眠</x:String>
                    <x:String>离线</x:String>
                </RadioButtons>

                <!-- 定时策略：列表 + 新增对话框 + 删除（票 #10，DESIGN.md 4.2）；磁盘缺失/受限时行内红字标记异常状态 -->
                <TextBlock
                    Margin="0,16,0,0"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="定时策略" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="在指定星期与时刻把指定磁盘转入指定状态；锁不住则跳过本次并托盘通知，不重试。"
                    TextWrapping="Wrap" />
                <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding Settings.Schedules}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="0,4"
                                Padding="12,8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <Grid>
                                    <StackPanel Spacing="2">
                                        <TextBlock FontWeight="SemiBold">
                                            <Run Text="{Binding DiskLabel}" /><Run Text=" · " /><Run Text="{Binding TimeText}" /><Run Text=" · " /><Run Text="{Binding DaysText}" /><Run Text=" → " /><Run Text="{Binding TargetText}" />
                                        </TextBlock>
                                        <TextBlock
                                            Foreground="#C62828"
                                            Text="{Binding ProblemText}"
                                            Visibility="{Binding HasProblem, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </StackPanel>
                                    <Button
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Content="删除"
                                        Command="{Binding DeleteCommand}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button
                    Margin="0,4,0,0"
                    HorizontalAlignment="Left"
                    Content="新增策略"
                    Click="OnAddScheduleClick" />

                <Button
                    Margin="0,16,0,0"
                    HorizontalAlignment="Left"
                    Content="返回"
                    Command="{Binding CloseSettingsCommand}" />
            </StackPanel>
        </Grid>

        <!-- 底栏：左下角设置入口（DESIGN.md 4.1） -->
        <Button
            Grid.Row="2"
            Margin="0,16,0,0"
            HorizontalAlignment="Left"
            Command="{Binding OpenSettingsCommand}"
            Visibility="{Binding IsDiskViewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon
                    Glyph="&#xE713;"
                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                    FontSize="16" />
                <TextBlock Text="设置" />
            </StackPanel>
        </Button>
    </Grid>
</Window>
